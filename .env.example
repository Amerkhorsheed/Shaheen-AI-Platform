# ---------------------------------------------------------------
# منظومة OSS للذكاء الاصطناعي — إعدادات البيئة
# انسخ هذا الملف إلى ‎.env‎ واملأ القيم قبل أول تشغيل.
# ملف ‎.env‎ مستثنى من Git ويجب ألا يُرفع إلى المستودع إطلاقاً.
# ---------------------------------------------------------------

# --- قاعدة البيانات (PostgreSQL) ---
# استخدم كلمة مرور عشوائية طويلة، ولا تعد استخدام كلمة مرور من نظام آخر.
#   توليدها:  openssl rand -base64 24
POSTGRES_USER=shaheen_admin
POSTGRES_PASSWORD=
POSTGRES_DB=shaheen_ai

# للتشغيل المباشر خارج دوكر استخدم 127.0.0.1، وداخل docker compose استخدم postgres
DATABASE_URL=postgresql://shaheen_admin:CHANGE_ME@127.0.0.1:5432/shaheen_ai

# --- مفتاح توقيع الجلسات ---
# إلزامي. 32 خانة على الأقل. تغييره يُبطل جميع الجلسات القائمة فوراً.
#   توليده:  openssl rand -base64 48
JWT_SECRET=

# مدة صلاحية رمز الجلسة (افتراضياً 8 ساعات)
TOKEN_TTL=8h

# --- الخادم ---
PORT=3001
HOST=0.0.0.0

# اربط المنفذ بـ 127.0.0.1 إن أردت قصر الوصول على الجهاز نفسه دون الشبكة المحلية
APP_BIND=0.0.0.0

# فعّلها فقط خلف وكيل عكسي موثوق (يؤثر على تحديد المعدل وتسجيل عناوين IP)
# TRUST_PROXY=true

# فعّلها فقط عند إنهاء TLS أمام التطبيق
# ENABLE_HSTS=true

# نطاقات إضافية مسموح بها للطلبات عابرة النطاق (خادم Vite أثناء التطوير)
# ALLOWED_ORIGINS=http://localhost:5173

# --- محرك النموذج المحلي ---
# يُقبل فقط عنوان محلي أو ضمن شبكة خاصة (حماية من SSRF)
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# --- الحساب الإداري الأول ---
# اتركه فارغاً لتوليد كلمة مرور عشوائية تُطبع مرة واحدة في سجل الخادم عند
# أول إقلاع لقاعدة بيانات جديدة. في الحالتين يُطلب تغييرها عند أول دخول.
INITIAL_ADMIN_PASSWORD=

# --- معالجة ورفع الملفات والمستندات ---
# الحد الأقصى لحجم الملف الواحد بالبايت (افتراضياً 50 ميغابايت = 52428800)
# MAX_UPLOAD_BYTES=52428800
# الحد الأقصى لعدد الملفات في الرفع الواحد
# MAX_UPLOAD_FILES=20
# الحد الأقصى لعدد المحارف المستخرجة من المستند للنموذج (افتراضياً 80,000 محرف).
# رفعه يتجاوز نافذة سياق النموذج فيفشل الطلب كاملاً؛ جداول البيانات الكبيرة لا تتأثر به
# لأنها تُحلَّل على كامل أسطرها إلى ملف إحصائي بدل نصها الخام.
# MAX_EXTRACTED_CHARS=80000
# الحد الأقصى لحجم حمولة طلب المحادثة (افتراضياً 50mb)
# BODY_LIMIT=50mb
# الحد الأقصى لعدد الرسائل في طلب المحادثة الواحد
# CHAT_MAX_MESSAGES=1000
# الحد الأقصى لمحارف الرسالة الواحدة. إن تُرك دون تعيين يُحسب تلقائياً:
# MAX_EXTRACTED_CHARS × MAX_UPLOAD_FILES + 200000 (لأن نصوص الملفات المرفقة تُضمَّن في الرسالة)
# CHAT_MAX_CONTENT_CHARS=1800000

# --- التوجيه التلقائي بين النماذج (Auto Router) ---
# معرّف النموذج المخصص لكل اختصاص كما يظهر في LM Studio
# ROUTER_MODEL_ADMINISTRATIVE=qwen3.8-27b
# ROUTER_MODEL_FINANCIAL=deepseek-r1-distill-qwen-32b
